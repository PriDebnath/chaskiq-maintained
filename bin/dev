#!/usr/bin/env bash

if ! command -v foreman &> /dev/null
then
  echo "⬇️Installing foreman..."
  gem install foreman
fi

# Remove stale PID file
rm -f tmp/pids/server.pid

# Wait for database and run migrations
echo "⏳Waiting for database to be ready..."
max_attempts=30
attempt=0
until bin/rails runner "ActiveRecord::Base.connection" 2>/dev/null; do
  attempt=$((attempt + 1))
  if [ $attempt -ge $max_attempts ]; then
    echo "❌ Database connection timeout after $max_attempts attempts"
    break
  fi
  echo "🔄 Database is unavailable - sleeping (attempt $attempt/$max_attempts)"
  sleep 2
done

if bin/rails runner "ActiveRecord::Base.connection" 2>/dev/null; then
  echo "🔄 Running database migrations..."
  bin/rails db:migrate || echo "✅ Migration check completed"
else
  echo "❌ Skipping migrations - database not available"
fi

foreman start -f Procfile.dev
